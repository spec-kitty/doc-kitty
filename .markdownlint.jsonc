// Common Docs — Kitty Variation: a boring, shared Markdown ruleset.
// Consumed by markdownlint-cli2 (devDependency; CI wires the file globs in WP04).
// Intent: catch structural mistakes (heading jumps, inconsistent lists, bare
// URLs) while staying out of the way of prose style. Sentence-case, tone, and
// word choice are NOT enforced here — that is Vale's job.
{
  // Start from the full default rule set, then relax the noisy/stylistic ones.
  "default": true,

  // --- Structural rules we care about (left on by "default": true) ---
  // MD001 heading-increment ....... headings go up one level at a time
  // MD004 ul-style ................. one unordered-list marker style, repo-wide
  // MD034 no-bare-urls ............ links must be real links, not bare URLs

  "MD004": { "style": "dash" }, // unordered lists use "-" (the list-style rule)
  "MD007": { "indent": 2 }, // nested list indent = 2 spaces
  "MD030": { "ul_single": 1, "ol_single": 1, "ul_multi": 1, "ol_multi": 1 },
  "MD029": false, // ordered-list numbering — authors use intentional continued
  //                 numbering (e.g. a ranked 1..N checklist across subsections)

  // Convention twist: every page carries a frontmatter `title` AND opens with a
  // body `# H1`. Tell MD025 not to count the frontmatter title as a heading, so
  // a single body H1 is still valid while genuine double-H1s are still caught.
  "MD025": { "front_matter_title": "" },

  // --- Relaxations: prose formatting the convention deliberately allows ---
  "MD013": false, // line length — prose/tables/links wrap freely
  "MD024": { "siblings_only": true }, // repeated headings OK in separate sections
  "MD033": false, // inline HTML — components / <br> / <Figure> are used
  "MD036": false, // emphasis-as-heading — used for short callouts
  "MD041": false, // first line need not be a heading (YAML frontmatter precedes)
  "MD046": false, // code-block style — indented and fenced both appear
  "MD060": false // table-column-style — pipe spacing/alignment is not enforced
}
