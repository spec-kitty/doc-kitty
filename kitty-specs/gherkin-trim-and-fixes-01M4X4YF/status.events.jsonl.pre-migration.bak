{"aggregate_id": "01M4X4YFF50NC7V053W0H2MGG9", "aggregate_type": "Mission", "event_id": "01M4X4YGV15WRPYRYD23DJSN14", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-14T12:07:15.193788+00:00", "friendly_name": "Gherkin test trim and fixes", "mission_id": "01M4X4YFF50NC7V053W0H2MGG9", "mission_number": null, "mission_slug": "gherkin-trim-and-fixes-01M4X4YF", "mission_type": "software-dev", "purpose_context": "The Gherkin feature (generated pages, fences, includes) shipped with about 4,700 test lines that overlap across layers, plus five known gaps: mis-cased status shorthands publish silently, draft-only directories get no index, hub titles cannot spell acronyms, llms.txt can advertise a missing scenario index, and one example feature is copied three times with no parity check. This mission closes the gaps test-first, then trims the suite so each behaviour has one owning guard.", "purpose_tldr": "Trim overlapping Gherkin tests and fix five small Gherkin defects before the next stable release.", "target_branch": "issue-156-gherkin-trim-and-fixes", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-10-14T12:07:15.553728+00:00"}
