{"aggregate_id": "01M0PFQT2HACYCTZN2MS6S9A16", "aggregate_type": "Mission", "event_id": "01M0PFQX5PAVRBKBJ99KS6QE96", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-23T04:58:21.650549+00:00", "friendly_name": "Metadata model and chrome", "mission_id": "01M0PFQT2HACYCTZN2MS6S9A16", "mission_number": null, "mission_slug": "metadata-model-and-chrome-01M0PFQT", "mission_type": "software-dev", "purpose_context": "doc-kitty renders a repository's docs tree as a human-first, agent-supported site, and every page's frontmatter is the contract that navigation, share cards, feeds, and the agent-API read from. Mission M1 finalizes that contract (doc_status, kind, and the rest), builds the validator that enforces it, migrates the whole tree onto it, and renders the metadata-driven page chrome on the theme's slot surface, so later missions build on a stable, enforced foundation.", "purpose_tldr": "Finalize the frontmatter metadata contract every page carries, enforce it with a validator, migrate all docs onto it, and render per-kind metadata-driven page chrome.", "target_branch": "feat/metadata-model-and-chrome", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-08-23T04:58:24.822202+00:00"}
