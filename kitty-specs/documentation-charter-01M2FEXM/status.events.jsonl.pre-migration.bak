{"at": "2026-09-14T08:21:41.425637+00:00", "event_id": "01M2FG3XXHY5YBHP9HFAH0V4KJ", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M2FF0J5CAF7WYYXZ5QJX8FR3", "final_answer": "New consolidated charter file that absorbs vocabulary.yaml + sections.yaml into one authoritative _meta charter; existing _meta/vocabulary.yaml and _meta/sections.yaml remain honored (deprecated, back-compat) so the proven N=2 consumer path does not regress, with a documented migration.", "mission_id": "01M2FEXMH2ZTZ1WR67J62QSN2H", "mission_slug": "documentation-charter-01M2FEXM", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-09-14T08:21:41.425637Z", "resolved_by": "cli", "run_id": "01M2FF0J5CAF7WYYXZ5QJX8FR3", "state_entered_at": "2026-09-14T08:21:41.424915Z", "summary": null, "terminal_outcome": "resolved"}}
{"at": "2026-09-14T08:21:48.662690+00:00", "event_id": "01M2FG44ZP0EQ6Z71G40PVAQG7", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M2FF0RZYJ68F53BV6ACYGFRJ", "final_answer": "Deferred. Keep the shipped warn-not-fail posture; no consumer-tunable strictness engine in this mission. A configurable-enforcement/strictness surface is split to the separate Layer-B item.", "mission_id": "01M2FEXMH2ZTZ1WR67J62QSN2H", "mission_slug": "documentation-charter-01M2FEXM", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-09-14T08:21:48.662690Z", "resolved_by": "cli", "run_id": "01M2FF0RZYJ68F53BV6ACYGFRJ", "state_entered_at": "2026-09-14T08:21:48.661953Z", "summary": null, "terminal_outcome": "resolved"}}
{"at": "2026-09-14T08:21:55.950440+00:00", "event_id": "01M2FG4C3E7WN0JBCPAH4EZJTA", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M2FF0ZVC0AX7NPJ6GXE9P4D6", "final_answer": "Extend-only. doc_status becomes consumer-overridable via the same alias/forbid axis as type/kind, but the canonical statuses (draft, published, durable, etc.) stay reserved and non-removable so Hub draft-exclusion, feeds, and the durable throughline keep working.", "mission_id": "01M2FEXMH2ZTZ1WR67J62QSN2H", "mission_slug": "documentation-charter-01M2FEXM", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-09-14T08:21:55.950440Z", "resolved_by": "cli", "run_id": "01M2FF0ZVC0AX7NPJ6GXE9P4D6", "state_entered_at": "2026-09-14T08:21:55.949701Z", "summary": null, "terminal_outcome": "resolved"}}
