{"aggregate_id": "01M2FEXMH2ZTZ1WR67J62QSN2H", "aggregate_type": "Mission", "event_id": "01M2FEXQH1E4E640ZNQ7XPT4WZ", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-14T08:00:49.688914+00:00", "friendly_name": "Documentation Charter (M7)", "mission_id": "01M2FEXMH2ZTZ1WR67J62QSN2H", "mission_number": null, "mission_slug": "documentation-charter-01M2FEXM", "mission_type": "software-dev", "purpose_context": "doc-kitty already lets a consumer override its vocabulary, section registry, and theme, but those governance knobs are scattered and undocumented as one thing, and a few (doc_status, required fields) are still hardcoded. This mission consolidates the shipped seams under a single, portable 'documentation charter' surface, closes the last hardcoded knobs, and fulfils the convention's standing promise to be recast as a charter/doctrine \u2014 without coupling adopters to the Spec Kitty engine.", "purpose_tldr": "Give adopters one coherent, doc-kitty-native place to govern their documentation convention \u2014 no Spec Kitty runtime required.", "target_branch": "feat/documentation-charter", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-09-14T08:00:49.697316+00:00"}
