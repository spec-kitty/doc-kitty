{"aggregate_id": "01M4VB0NPEBCH4163JZ3RE252K", "aggregate_type": "Mission", "event_id": "01M4VB0RSF5HCKCHCDCQTBRSF6", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-10-13T19:14:51.630092+00:00", "friendly_name": "Generated pages and relative links hold up for consumers", "mission_id": "01M4VB0NPEBCH4163JZ3RE252K", "mission_number": null, "mission_slug": "generated-page-and-link-integrity-01M4VB0N", "mission_type": "software-dev", "purpose_context": "Three defects found during adoption break a consumer's site without failing its build: an empty Gherkin source directory silently deletes every generated behaviour page, glossary pages are written under a filename the default settings do not treat as a section index so term links 404, and ordinary relative Markdown links between pages 404 on the published site while the source link check passes them. This mission makes each of these either work or stop the build with a clear message.", "purpose_tldr": "A site built with the toolkit keeps its generated pages and its cross-page links working for adopters on default settings.", "target_branch": "fix/generated-page-and-link-integrity", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-10-13T19:14:51.823152+00:00"}
