{"aggregate_id": "01M84X07GSZS94MXX0RYYNMBJK", "aggregate_type": "Mission", "event_id": "01M84X08APPSZHZ8QES5QYHE8H", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-23T19:09:24.644786+00:00", "friendly_name": "Sub-processor catalog", "mission_id": "01M84X07GSZS94MXX0RYYNMBJK", "mission_number": null, "mission_slug": "subprocessor-catalog-01M84X07", "mission_type": "software-dev", "purpose_context": "Data-protection terms require a current, change-notified list of sub-processors. Today that list is prose that nothing checks or publishes. This mission adds an optional catalog file with validation, a machine-readable export, a change feed, a generated list page and a link to the measures catalog. The toolkit supplies the structure; each site supplies its own facts. Tracks issue #403 in epic #400.", "purpose_tldr": "Let a documentation site keep a validated list of its sub-processors and announce changes to it.", "target_branch": "feat/403-subprocessor-catalog", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-11-23T19:09:24.694900+00:00"}
