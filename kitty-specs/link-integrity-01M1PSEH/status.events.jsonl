{"aggregate_id": "01M1PSEH7Q72MYA6V7WF8FQW5S", "aggregate_type": "Mission", "event_id": "01M1PSEH7Z79CXRE11J3ZNKEJ0", "event_type": "MissionCreated", "payload": {"created_at": "2026-09-04T18:03:45.271750+00:00", "friendly_name": "Internal link integrity \u2014 base-prefix, relative-link & glossary-anchor 404s", "mission_id": "01M1PSEH7Q72MYA6V7WF8FQW5S", "mission_number": null, "mission_slug": "link-integrity-01M1PSEH", "mission_type": "software-dev", "purpose_context": "The example docsite ships many broken internal links: glossary term links and hand-authored section links omit the /doc-kitty base and 404; relative links on leaf pages resolve as children and 404; glossary term headings render literal {#anchor} text with doubled ids so fragments never resolve; and the link-check gate reports success while all of it is broken. This mission makes internal links resolve and makes the gate fail-closed. Closes #61, #62, #63.", "purpose_tldr": "Internal links stop 404-ing: glossary terms, section links, and relative links resolve under the site base, and the link gate catches breakage instead of passing it.", "target_branch": "fix/link-integrity", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-09-04T18:03:45.279520+00:00"}
