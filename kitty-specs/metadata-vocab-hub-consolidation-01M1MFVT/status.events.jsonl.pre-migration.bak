{"aggregate_id": "01M1MFVTZGD9KQ6QWYV54ZDBQH", "aggregate_type": "Mission", "event_id": "01M1MFVZM03GXZ1SPH2KXJD80M", "event_type": "MissionCreated", "payload": {"created_at": "2026-09-03T20:37:46.608743+00:00", "friendly_name": "Metadata / Vocabulary / Hub Consolidation", "mission_id": "01M1MFVTZGD9KQ6QWYV54ZDBQH", "mission_number": null, "mission_slug": "metadata-vocab-hub-consolidation-01M1MFVT", "mission_type": "software-dev", "purpose_context": "Bundles three issues (#49, #39, #50) deferred from the qol-adoption-enablers mission and surfaced by the spec-kitty adoption study. Together they reduce adopter friction and fix doc-kitty's own dogfooding gaps on the metadata \u2192 vocabulary \u2192 Hub-rendering surface.", "purpose_tldr": "Close three deferred adoption enablers: eliminate the mjs\u2194ts vocabulary split-brain, add the durable doc_status, and make the ADR Hub card number-ordered and status-aware.", "target_branch": "feat/metadata-vocab-hub-consolidation", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-09-03T20:37:51.360617+00:00"}
