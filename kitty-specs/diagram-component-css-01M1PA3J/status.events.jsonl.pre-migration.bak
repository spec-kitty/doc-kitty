{"aggregate_id": "01M1PA3JC2SX50KXRS4C60ZAQ5", "aggregate_type": "Mission", "event_id": "01M1PA3JC9JYFGXBMP8CC9M6R9", "event_type": "MissionCreated", "payload": {"created_at": "2026-09-04T13:35:37.347325+00:00", "friendly_name": "Diagram markup + component-CSS delivery fixes", "mission_id": "01M1PA3JC2SX50KXRS4C60ZAQ5", "mission_number": null, "mission_slug": "diagram-component-css-01M1PA3J", "mission_type": "software-dev", "purpose_context": "The example docsite ships malformed diagram markup (every Mermaid figure is wrapped in a stray code-block box) and, because branding replaces the base stylesheet, global component styles (callouts today, diagrams next) never reach branded docs pages. This mission makes the diagram figure well-formed and ensures component CSS survives branding on both in-frame docs and out-of-frame decks. Closes #59, #60, #68.", "purpose_tldr": "Diagrams and Markua callouts render correctly on branded docs and decks \u2014 no double-boxed diagrams, no unstyled components.", "target_branch": "fix/diagram-component-css", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-09-04T13:35:37.353909+00:00"}
