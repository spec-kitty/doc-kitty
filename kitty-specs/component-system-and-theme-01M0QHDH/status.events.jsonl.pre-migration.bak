{"aggregate_id": "01M0QHDH2H1SM31VEYRD8G1D8P", "aggregate_type": "Mission", "event_id": "01M0QHDM3D0NTSWGXXMD7Y19P9", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-23T14:46:56.339765+00:00", "friendly_name": "Component system + swappable theme", "mission_id": "01M0QHDH2H1SM31VEYRD8G1D8P", "mission_number": null, "mission_slug": "component-system-and-theme-01M0QHDH", "mission_type": "software-dev", "purpose_context": "doc-kitty is built to become a general documentation template. Its look and chrome must be a swappable, layered concern so any product line can apply its own brand without copying and diverging the toolkit. This mission builds that theme layer (default -> brand -> consumer), ships the first real brand theme end-to-end to prove the contract, and stands up the accessibility/visual test harness that keeps every theme WCAG-conformant.", "purpose_tldr": "Let a consumer rebrand the docsite by selecting a theme \u2014 no fork required \u2014 and ship the first brand theme (Spec Kitty).", "target_branch": "feat/component-system-and-theme", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-08-23T14:46:59.437356+00:00"}
