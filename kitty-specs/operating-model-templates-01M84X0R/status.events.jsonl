{"aggregate_id": "01M84X0RH8AJE7NXQK093SGRF0", "aggregate_type": "Mission", "event_id": "01M84X0SDCB5PZ6QYDYTTHHNYC", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-23T19:09:42.123013+00:00", "friendly_name": "Operating-model templates and a Role kind", "mission_id": "01M84X0RH8AJE7NXQK093SGRF0", "mission_number": null, "mission_slug": "operating-model-templates-01M84X0R", "mission_type": "software-dev", "purpose_context": "About half of the EU SCC technical-and-organisational-measure headings describe an operating model (governance, accountability, incident handling, supplier management). DocKitty can stub a page today but gives no body template and has no kind for an accountable role. This mission adds an opt-in operating-model section preset, structure-and-prompt templates in the stub tools, and a Role kind, so consumers can document their operating model and classify it against the measures catalog.", "purpose_tldr": "Give teams ready page templates for documenting how their organisation runs, plus a Role page kind for accountable functions.", "target_branch": "feat/402-operating-model-templates", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-11-23T19:09:42.188957+00:00"}
