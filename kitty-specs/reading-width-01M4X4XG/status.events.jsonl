{"aggregate_id": "01M4X4XGQ92SEMD7FXG9N01JB1", "aggregate_type": "Mission", "event_id": "01M4X4XJ8AGPR42YE1JGDSV6Y0", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-14T12:06:43.749939+00:00", "friendly_name": "Wider reading column and room for wide content", "mission_id": "01M4X4XGQ92SEMD7FXG9N01JB1", "mission_number": null, "mission_slug": "reading-width-01M4X4XG", "mission_type": "software-dev", "purpose_context": "Issue #154: the 45rem default reading column sits centred in a large empty frame on 1440-2560px screens, and tables are squashed inside it. This mission settles a new --dk-width-content default from line-length measurements, lets wide tables use the reading pane without crowding the TOC rail, keeps small screens unchanged, and documents how to restore 45rem. It gates the next stable release.", "purpose_tldr": "Raise DocKitty's default reading width and let tables grow past it on wide screens, so wide-screen pages stop squashing tables beside empty space.", "target_branch": "issue-154-reading-width", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-10-14T12:06:44.234529+00:00"}
