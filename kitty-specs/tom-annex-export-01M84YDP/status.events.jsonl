{"aggregate_id": "01M84YDPJCBFNXNWKGGVX39KCX", "aggregate_type": "Mission", "event_id": "01M84YDQCNP9FC46HGXM8HBX08", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-23T19:34:14.625560+00:00", "friendly_name": "TOM annex export: an evidence index", "mission_id": "01M84YDPJCBFNXNWKGGVX39KCX", "mission_number": null, "mission_slug": "tom-annex-export-01M84YDP", "mission_type": "software-dev", "purpose_context": "Pages already classify the measures they evidence (ADR-0080), but nothing gathers them per measure, shows which measures lack evidence, or gives an auditor a versioned entry point. This mission adds that index as a stable, documented format that a shared organisation bundle (#404) can build on, under the generated-section contract of #359. The contractual DPA annex stays the parties' own document; wording on generated surfaces awaits counsel review.", "purpose_tldr": "Publish a generated api/tom-annex.json that gathers, per catalogued technical and organisational measure, the documentation pages that evidence it: an evidence index, not the contractual annex.", "target_branch": "feat/401-tom-annex-export", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-11-23T19:34:14.677982+00:00"}
