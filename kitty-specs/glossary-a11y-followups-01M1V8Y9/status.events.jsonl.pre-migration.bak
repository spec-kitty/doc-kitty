{"at": "2026-09-06T11:52:22.323561+00:00", "event_id": "01M1V8ZYHKKFDYD7WZADT7GM18", "event_type": "DecisionPointOpened", "payload": {"actor_id": "cli", "actor_type": "human", "decision_point_id": "01M1V8ZYHJYYVGY438PB166WAX", "input_key": "term_affordance_mechanism", "mission_id": "01M1V8Y9CEPZ10S13GR2YG8JTM", "mission_slug": "glossary-a11y-followups-01M1V8Y9", "mission_type": "software-dev", "options": ["aria-label composed from link text (attribute; no textContent pollution)", "visually-hidden text child (span.dk-visually-hidden)", "aria-roledescription on the anchor", "Other"], "origin_flow": "specify", "origin_surface": "planning_interview", "phase": "SPECIFY", "question": "How should a glossary term link be made distinguishable from an ordinary link for assistive technology (SSR/no-JS, single shared builder)?", "recorded_at": "2026-09-06T11:52:22.323561Z", "run_id": "01M1V8ZYHJYYVGY438PB166WAX", "state_entered_at": "2026-09-06T11:52:22.322990Z", "step_id": "specify.a11y.term-affordance-mechanism"}}
{"at": "2026-09-06T12:04:26.212324+00:00", "event_id": "01M1V9P1F4MRRAW7EWRFA195MG", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M1V8ZYHJYYVGY438PB166WAX", "final_answer": "aria-label composed from the link's visible text + ', glossary term' \u2014 an attribute on the shared builder, so both emitters stay byte-identical and the textContent-based links-used re-derive is untouched; SSR/no-JS-safe.", "mission_id": "01M1V8Y9CEPZ10S13GR2YG8JTM", "mission_slug": "glossary-a11y-followups-01M1V8Y9", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-09-06T12:04:26.212324Z", "resolved_by": "cli", "run_id": "01M1V8ZYHJYYVGY438PB166WAX", "state_entered_at": "2026-09-06T12:04:26.211633Z", "summary": null, "terminal_outcome": "resolved"}}
