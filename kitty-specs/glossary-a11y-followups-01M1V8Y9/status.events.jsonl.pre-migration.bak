{"aggregate_id": "01M1V8Y9CEPZ10S13GR2YG8JTM", "aggregate_type": "Mission", "event_id": "01M1V8Y9CQK1WTSKZMBKHTWB30", "event_type": "MissionCreated", "payload": {"created_at": "2026-09-06T11:51:27.886950+00:00", "friendly_name": "Glossary a11y follow-up cluster (#77/#78/#79)", "mission_id": "01M1V8Y9CEPZ10S13GR2YG8JTM", "mission_number": null, "mission_slug": "glossary-a11y-followups-01M1V8Y9", "mission_type": "software-dev", "purpose_context": "The glossary surface distinguishes a term link from an ordinary link only visually today, so assistive-technology users cannot perceive the difference. Two byte-identical link builders are kept in sync only by discipline plus a parity test, and the popover's caret/viewport-flip positioning has no automated regression guard. This mission closes those three follow-ups from the #64 glossary-term-ux review as one coherent slice on the glossary bounded context.", "purpose_tldr": "Make glossary term links tell screen-reader users they are terms, guard the popover's positioning, and collapse two duplicate link builders into one.", "target_branch": "feat/glossary-a11y-followups", "wp_count": 0}, "project_slug": "doc-kitty", "project_uuid": "9d9292b2-03dc-4abd-bbcf-49249387fb1c", "schema_version": "5.0.0", "timestamp": "2026-09-06T11:51:27.895899+00:00"}
