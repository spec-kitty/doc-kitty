{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": [
          "seo",
          "accessibility",
          "best-practices"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "errors-in-console": ["error", { "maxLength": 0 }]
      }
    }
  }
}
