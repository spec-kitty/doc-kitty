{
  "name": "doc-kitty",
  "version": "0.0.0",
  "private": true,
  "description": "Common Docs — Kitty Variation: a reusable Astro + Starlight scaffold for human-first, agent-supported documentation.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter example dev",
    "build": "pnpm --filter example build",
    "preview": "pnpm --filter example preview",
    "test": "pnpm --filter @commondocs-kitty/toolkit test",
    "typecheck": "pnpm --filter example typecheck",
    "lint": "eslint src",
    "validate": "pnpm --filter example run validate",
    "validate:docs": "node src/scripts/validate-frontmatter.mjs docs",
    "validate:example": "node src/scripts/validate-frontmatter.mjs example/docs",
    "validate:links": "node src/scripts/check-links.mjs docs example/docs",
    "assert:artifacts": "node src/scripts/assert-build-artifacts.mjs example/dist",
    "test:a11y": "playwright test"
  },
  "keywords": [
    "astro",
    "starlight",
    "documentation",
    "docs-as-code",
    "common-docs",
    "llms-txt",
    "agent-docs"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "eslint": "^10.9.0",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
