{
  "name": "doc-kitty",
  "version": "0.0.0",
  "private": true,
  "description": "Common Docs — Kitty Variation: a reusable Astro + Starlight scaffold for human-first, agent-supported documentation.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter example dev",
    "build": "pnpm --filter example build",
    "clean": "rm -rf example/.astro example/dist example/node_modules/.astro example/node_modules/.vite",
    "preview": "pnpm --filter example preview",
    "test": "pnpm --filter @commondocs-kitty/toolkit test",
    "typecheck": "pnpm --filter example typecheck",
    "lint": "eslint src",
    "validate": "pnpm --filter example run validate",
    "validate:docs": "node src/scripts/validate-frontmatter.mjs docs",
    "validate:example": "node src/scripts/validate-frontmatter.mjs example/docs --index-basename README,index",
    "validate:links": "node src/scripts/check-links.mjs docs example/docs",
    "validate:adr-index": "node src/scripts/generate-adr-index.mjs --check",
    "validate:catalog": "node src/scripts/validate-catalog.mjs docs example/docs",
    "assert:artifacts": "node src/scripts/assert-build-artifacts.mjs example/dist",
    "assert:no-broken-links": "node src/scripts/assert-no-broken-links.mjs example/dist --base /doc-kitty --site https://spec-kitty.github.io",
    "assert:markua": "node src/scripts/assert-markua-builds.mjs",
    "test:a11y": "playwright test"
  },
  "keywords": [
    "astro",
    "starlight",
    "documentation",
    "docs-as-code",
    "common-docs",
    "llms-txt",
    "agent-docs"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "mdast-util-directive": "3.1.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-smartypants": "3.0.3",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "eslint": "^10.9.0",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
