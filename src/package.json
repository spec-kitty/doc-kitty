{
  "name": "@spec-kitty/doc-toolkit",
  "version": "0.1.1",
  "description": "Reusable Astro + Starlight toolkit for DocKitty — a documentation convention based on Common Docs: schema, README-as-index loader, and rss/llms.txt/agent-API route handlers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spec-kitty/doc-kitty.git",
    "directory": "src"
  },
  "homepage": "https://spec-kitty.github.io/doc-kitty/",
  "bugs": {
    "url": "https://github.com/spec-kitty/doc-kitty/issues"
  },
  "keywords": [
    "astro",
    "starlight",
    "documentation",
    "docs-as-code",
    "dockitty",
    "common-docs",
    "llms-txt",
    "agent-docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.ts",
    "./config": "./lib/config.ts",
    "./schema": "./lib/schema.ts",
    "./routes": "./lib/routes/index.ts",
    "./route-middleware": "./lib/route-middleware.ts",
    "./deck/*": "./lib/deck/*.ts",
    "./components/*": "./components/*",
    "./layouts/*": "./layouts/*",
    "./themes/*": "./themes/*",
    "./assets/*": "./assets/*",
    "./styles/*": "./styles/*",
    "./scripts/*": "./scripts/*"
  },
  "bin": {
    "dockitty-validate-frontmatter": "./scripts/validate-frontmatter.mjs",
    "dockitty-check-links": "./scripts/check-links.mjs",
    "dockitty-assert-no-broken-links": "./scripts/assert-no-broken-links.mjs",
    "dockitty-check-redirect-coverage": "./scripts/check-redirect-coverage.mjs",
    "dockitty-validate-catalog": "./scripts/validate-catalog.mjs",
    "dockitty-new-doc": "./scripts/new-doc.mjs",
    "dockitty-scaffold": "./scripts/scaffold.mjs"
  },
  "files": [
    "index.ts",
    "lib",
    "scripts",
    "components",
    "layouts",
    "themes",
    "assets",
    "styles",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.32.0 <0.33.0",
    "astro": ">=5.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "@beoe/rehype-mermaid": "0.4.2",
    "astro-plantuml": "1.0.0",
    "gray-matter": "^4.0.3",
    "mermaid": "11.17.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-smartypants": "^3.0.3",
    "reveal.js": "6.0.1",
    "unified": "^11.0.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.32.6",
    "astro": "^5.2.0",
    "mdast-util-to-hast": "13.2.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
