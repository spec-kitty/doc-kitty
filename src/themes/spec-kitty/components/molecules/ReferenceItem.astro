---
/*
 * Reference-item molecule (WP05, T022).
 *
 * The related-card pattern for an external reference: a CARD-WIDE `<a>` with a mono
 * citation key, a muted description, and a decorative external-link icon. Built for
 * the `dk:external-references` block, which stays UNWIRED to resolved data in M2
 * (C-010) — this molecule renders from PROPS only, never `entry.data.external_references`.
 *
 * AA (T025): the `.dk-reference-item` class carries a ≥24px min target + a
 * `:focus-visible` ring in ../brand-components.css. The external-link icon is
 * decorative (`aria-hidden`) — its accessible name is carried by the visible key
 * and description text, never the icon alone. Self-contained (no `@spec-kitty/*`).
 */
interface Props {
  /** Destination URL — a real href so the whole item is one ≥24px link target. */
  href: string;
  /** Mono citation key (e.g. a short slug or ref id). */
  citationKey: string;
  /** Optional muted description. */
  description?: string;
}

const { href, citationKey, description } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  class="dk-reference-item"
  href={href}
  {...external ? { rel: 'noopener noreferrer', target: '_blank' } : {}}
>
  <span class="dk-reference-item__key">{citationKey}</span>
  {description && <span class="dk-reference-item__desc">{description}</span>}
  {
    external && (
      <>
        <svg
          class="dk-icon dk-reference-item__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M14 4h6v6" />
          <path d="M20 4 10 14" />
          <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
        </svg>
        <span class="dk-visually-hidden">(opens in a new tab)</span>
      </>
    )
  }
</a>
