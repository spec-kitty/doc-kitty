---
/*
 * Reference-item molecule (WP05, T022; title-first accessible name T025).
 *
 * The related-card pattern for an external reference: a CARD-WIDE `<a>` whose
 * LEADING (and therefore accessible) text is the human TITLE, with the mono
 * citation key as a SECONDARY affordance and an optional muted meta line
 * (author/year/container, or a note). Consumed by the `dk:external-references`
 * block (ADR-0017 carrier-body); renders from PROPS only (self-contained, no
 * `@spec-kitty/*`).
 *
 * T025 / FR-009 (post-spec finding R2): the citation KEY must never be the
 * leading or sole accessible name — the title leads. Inline references carry no
 * key, so only the title (+ optional note) shows.
 *
 * AA (T025): `.dk-reference-item` carries a ≥24px min target + a `:focus-visible`
 * ring in ../brand-components.css. The external-link icon is decorative
 * (`aria-hidden`); its accessible name is carried by the visible title text, never
 * the icon alone, plus a hidden "(opens in a new tab)".
 */
interface Props {
  /** Destination URL — a real href so the whole item is one ≥24px link target. */
  href: string;
  /** Human title — the LEADING/accessible name (inline title or resolved record title). */
  title: string;
  /** Mono citation key (catalog citations only) — a SECONDARY affordance, never leading. */
  citationKey?: string;
  /** Optional muted meta line: author/year/container, or a note. */
  meta?: string;
}

const { href, title, citationKey, meta } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  class="dk-reference-item"
  href={href}
  {...external ? { rel: 'noopener noreferrer', target: '_blank' } : {}}
>
  <span class="dk-reference-item__title">{title}</span>
  {citationKey && <span class="dk-reference-item__key">{citationKey}</span>}
  {meta && <span class="dk-reference-item__desc">{meta}</span>}
  {
    external && (
      <>
        <svg
          class="dk-icon dk-reference-item__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M14 4h6v6" />
          <path d="M20 4 10 14" />
          <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
        </svg>
        <span class="dk-visually-hidden">(opens in a new tab)</span>
      </>
    )
  }
</a>
