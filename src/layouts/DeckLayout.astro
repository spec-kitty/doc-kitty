---
/*
 * Doc Kitty layout: DeckLayout — the OUT-OF-FRAME reveal.js shell (ADR-0021 /
 * ADR-0022). Unlike the in-frame per-kind layouts (Default/Hub/Persona), this is
 * a COMPLETE HTML document: the deck route renders it directly, shadowing
 * Starlight's article frame for `/presentations/*`, so there is no Starlight
 * chrome, sidebar, or `.sl-markdown-content` wrapper here.
 *
 * Structure: `.reveal > .slides > <section>` — the shape reveal enhances. WP02's
 * slide TRANSFORM (splitting the body on `##`/`###` into one `<section>` per
 * slide, plus the speaker-note `<aside>`) has landed, so `<Content />` already
 * emits the deck's `<section>`s. It is rendered as the DIRECT child of `.slides`
 * — NOT wrapped in an extra `<section>` — so reveal sees the transform's
 * horizontal slides as top-level `.slides > section`, not a single vertical
 * stack collapsed inside one wrapper (WP04 integration fix; BA-2).
 *
 * SSR-safety (ADR-0022 D3): reveal is NEVER imported at the top level of this
 * file — it is loaded from the browser-only client `<script>` below, which
 * dynamically imports `reveal-init.client`. A top-level `import Reveal` would
 * pull a `document`/`window`-touching module into the SSG Node run and crash
 * `astro build`.
 *
 * CSS isolation (ADR-0022 D5 / BA-4): reveal's reset + core sheets and the
 * `--dk-*→--r-*` token map are imported with Vite's `?url` suffix and emitted as
 * explicit `<link>`s in THIS document's head. Because they are referenced only
 * here (never a global style, never a shared chunk a doc page links), reveal's
 * viewport-hijacking core sheet (`html,body{overflow:hidden}`) cannot leak onto
 * a documentation page.
 *
 * Token catalog on the out-of-frame route (ADR-0022 D4 / FR-009 / SC-004): the
 * `--dk-*→--r-*` map only RESOLVES if the `--dk-*` VALUES are in scope, but the
 * deck renders OUTSIDE the Starlight frame, so it never receives the global token
 * sheet Starlight injects on doc pages. DeckLayout therefore links the toolkit's
 * base `--dk-*` catalog (`theme.css`, light + dark) itself, and accepts a
 * `tokenCss` list so the consumer's deck route can layer brand/consumer token
 * overrides AFTER the base — the same default→brand→consumer order
 * `defineDocKittyIntegrations` gives the frame. Order is load-bearing: base
 * tokens → brand tokens → the `--dk-*→--r-*` map (which reads them).
 *
 * Pagefind (RT-05 / BA-5): a PUBLISHED deck exposes its slides to the index via
 * `data-pagefind-body` on `.slides`; a DRAFT deck (T007 smoke) carries
 * `data-pagefind-ignore` on `<body>` so its emitted HTML is not indexed at all.
 * (The speaker-note `<aside>` gets its own `data-pagefind-ignore` from the
 * transform.)
 */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { isPublished } from '../lib/metadata.js';
import { resolveDiagramMode } from '../lib/config.js';
import { GLOBAL_COMPONENT_SHEETS, DK_COMPONENTS_CSS_SHEET } from '../lib/theme.js';
// `?url`: emit each sheet as its own hashed asset linked ONLY from the deck
// document — the route-import isolation that keeps reveal's core CSS off doc
// pages (ADR-0022 D5). Never import these as bare (global) stylesheets.
import revealResetHref from 'reveal.js/reset.css?url';
import revealCoreHref from 'reveal.js/reveal.css?url';
// Base `--dk-*` catalog (light + dark) — linked on the deck itself because the
// out-of-frame route gets no global token injection (SC-004). Brand/consumer
// layers arrive via the `tokenCss` prop and are linked AFTER this.
import baseTokenHref from '../styles/theme.css?url';
// Global component CSS (`.dk-callout*` + `.dk-diagram*`) — the standalone sheet
// `config.ts` layers into `customCss` as its OWN entry for in-frame docs (#68/
// C-002). The out-of-frame deck route never receives that global injection, so
// DeckLayout links it explicitly here (diagram-component-css mission #59/#60/#68).
import dkComponentsHref from '../styles/dk-components.css?url';
import deckThemeHref from '../styles/dk-reveal-theme.css?url';

// Single-owner list (`theme.ts` `GLOBAL_COMPONENT_SHEETS`, finding #2 review):
// every global component sheet must reach BOTH the in-frame `customCss`
// injection (`config.ts`, via `DEFAULT_LAYER`) and this out-of-frame deck
// route. Vite's `?url` imports must be static string literals, so each sheet
// still needs its own hand-written import above — this map is the SINGLE place
// that ties a `GLOBAL_COMPONENT_SHEETS` specifier to its resolved href, and the
// iteration below THROWS at build time if a specifier has no entry here, so an
// addition to the shared list that forgets the deck fails LOUD instead of
// silently shipping an unstyled deck.
const GLOBAL_COMPONENT_HREFS: Record<string, string> = {
  [DK_COMPONENTS_CSS_SHEET]: dkComponentsHref,
};
const globalComponentHrefs = GLOBAL_COMPONENT_SHEETS.map((specifier) => {
  const href = GLOBAL_COMPONENT_HREFS[specifier];
  if (href === undefined) {
    throw new Error(
      `DeckLayout: no statically-imported href registered for global component sheet ` +
        `'${specifier}' (theme.ts GLOBAL_COMPONENT_SHEETS) — add a \`?url\` import above ` +
        `and register it in GLOBAL_COMPONENT_HREFS.`,
    );
  }
  return href;
});

interface Props {
  entry: CollectionEntry<'docs'>;
  /**
   * Ordered `--dk-*` token stylesheet hrefs to layer AFTER the base catalog
   * (brand then consumer), mirroring `defineDocKittyIntegrations` for the frame.
   * The consumer deck route passes its resolved theme token sheets here so the
   * deck matches the active brand (ADR-0022 D4). Omitted → base catalog only.
   */
  tokenCss?: string[];
  /**
   * Ordered brand/consumer deck LOOK sheet hrefs to layer AFTER the neutral
   * `--dk-*→--r-*` map (`deckThemeHref` below), mirroring the `tokenCss`
   * seam and the mission's C-001 separability principle: a house-style sheet
   * wins by SOURCE ORDER (plain specificity, loaded last) without touching
   * `dk-reveal-theme.css` itself, so the neutral default stays byte-unchanged
   * and independently selectable. Route-isolated — only linked when the
   * consumer's deck route passes it, exactly like `tokenCss`. Omitted → the
   * deck renders the neutral default look only.
   */
  deckThemeCss?: string[];
}

const { entry, tokenCss = [], deckThemeCss = [] } = Astro.props;
const published = isPublished(entry.data);
const { Content } = await render(entry);
const title = entry.data.title;
const description = entry.data.description ?? '';

// Diagram render mode (#13 WP03, FR-005/NFR-001). In BUILD mode the deck's
// ```mermaid fences are already baked to static inline `<svg>` by the shared
// markdown pipeline (same as a doc page) — so there is nothing to settle, and the
// client render owner (`initDiagrams`) is NEITHER imported NOR run on the deck:
// the reveal INV-SETTLE/SCOPE slide-by-slide machinery is reserved for the CLIENT
// fallback, where `pre.mermaid` sources still need a browser render. The resolved
// mode is stamped on `<body data-diagram-mode>` so the client `<script>` (a
// bundled module that cannot receive frontmatter vars directly) branches on it.
const diagramMode = resolveDiagramMode();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Deck theme selection (house-theme seam): the out-of-frame deck has no
        Starlight theme script, so without this it can only follow
        `prefers-color-scheme` via `@media` rules — and a brand's `[data-theme]`
        colour block (tokens.css) never fires on it. This inline, pre-paint
        script mirrors the viewer's OS preference onto `data-theme`, so the deck
        resolves the SAME `:root[data-theme='dark']` brand palette the in-frame
        chrome uses (winning by specificity over the neutral sheet's
        `@media (prefers-color-scheme: dark)` fallback), and a `data-theme`
        toggle re-themes the deck. No-JS falls back to the light `:root` palette
        (still legible — the demo slide uses theme tokens). Inline so it runs
        before first paint (no flash); route-isolated to the deck document. */}
    <script is:inline>
      try {
        var d = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var apply = function () {
          d.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
        };
        apply();
        mq.addEventListener('change', apply);
      } catch (e) {
        /* pre-DOM or no matchMedia: leave data-theme unset → light :root palette */
      }
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* Draft decks are never indexed by crawlers (RT-05); Pagefind is handled
        by the `data-pagefind-ignore` on the root below. */}
    {!published && <meta name="robots" content="noindex" />}
    <link rel="stylesheet" href={revealResetHref} />
    <link rel="stylesheet" href={revealCoreHref} />
    {/* Token catalog BEFORE the map: base `--dk-*`, then brand/consumer layers,
        then `--dk-*→--r-*` (which reads them). See the header note (SC-004). */}
    <link rel="stylesheet" href={baseTokenHref} />
    {tokenCss.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    {/* Global component CSS (.dk-callout + .dk-diagram rules) AFTER the token
        catalog (it consumes those tokens) and BEFORE the deck-specific reveal
        theme (so a future deck-scoped override still wins by source order)
        (#59/#60/#68). Iterates the single-owner GLOBAL_COMPONENT_SHEETS list
        (theme.ts) rather than hard-coding one link, per finding #2. */}
    {globalComponentHrefs.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    <link rel="stylesheet" href={deckThemeHref} />
    {/* Brand/consumer deck LOOK sheets (e.g. the spec-kitty house theme) layer
        AFTER the neutral --dk→--r map so they win by source order — the deck's
        house style stays selectable independently of the docsite chrome,
        route-isolated exactly like tokenCss above. */}
    {deckThemeCss.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
  </head>
  <body data-diagram-mode={diagramMode} {...(!published ? { 'data-pagefind-ignore': '' } : {})}>
    <main class="reveal" aria-label={`${title} — slide deck`}>
      {/* `data-pagefind-body` ONLY for a published deck: the slide content is
          the indexed region. A draft is fully excluded via the root ignore. */}
      {/* `<Content/>` is the DIRECT child of `.slides` (no wrapping `<section>`)
          so the transform's slides are top-level `.slides > section` — see the
          flatten note in the header comment (BA-2). */}
      <div class="slides" {...(published ? { 'data-pagefind-body': '' } : {})}>
        <Content />
      </div>
    </main>

    {/* Deck footer / bottom-banner (FR-003, C2). A SIBLING of `main.reveal`,
        deliberately OUTSIDE `.slides` so reveal never sweeps it into the slide
        DOM (no per-slide re-render, no accessible-slide-name interference,
        IX-3b) and outside the `data-pagefind-body` region so its title text is
        not indexed (BA-5). A single `contentinfo` landmark (a `<footer>` at
        `<body>` scope) carrying the deck title — kept unique so a11y stays green
        (NFR-004). Styled + positioned by `.dk-deck-footer` in the theme sheet so
        it never overlaps the fixed controls. */}
    <footer class="dk-deck-footer">{title}</footer>

    {/* Real, labelled <button> controls (AX-2), wired to reveal in the client
        init. Keyboard navigation (arrows/space/Esc) is reveal's, always on. */}
    <nav class="dk-deck-controls" aria-label="Slide navigation">
      <button type="button" class="dk-deck-prev" aria-label="Previous slide">‹</button>
      <button type="button" class="dk-deck-next" aria-label="Next slide">›</button>
      {/* Vertical-stack affordance (D-06 / C-AFFORD-1): hidden by default, both
          buttons start `hidden` here — the client controller (reveal-init.client,
          T005) toggles it on init + `slidechanged` from `availableRoutes()`, so a
          flat slide shows no misleading up/down cue. */}
      <button type="button" class="dk-deck-up" aria-label="Up (previous slide in stack)" hidden>▲</button>
      <button type="button" class="dk-deck-down" aria-label="Down (next slide in stack)" hidden>▼</button>
    </nav>

    {/* Browser-only: Astro bundles this script for the client; the dynamic
        import keeps reveal (and its DOM access) out of the SSG build.

        Diagrams inside the deck (FR-009 / M6 C-008) render AFTER reveal has
        finished initialising, NOT concurrently. The out-of-frame shell bypasses
        Starlight, so `config.ts`'s page-level `injectScript` never reaches it —
        DeckLayout must drive the SAME shared render owner itself (WP03,
        `diagram-render.client`; NFR-007 — no second render path). Ordering is
        load-bearing for accessibility (NFR-001): reveal's initialise mutates the
        `.slides` DOM, and a diagram rendered into a slide WHILE that is in flight
        loses its injected `accTitle`/`accDescr` — Mermaid's `<title>`/`<desc>`
        insertion throws mid-render, leaving a graph with NO accessible name.
        Rendering once reveal's `initialize()` promise has settled avoids the
        race (reveal does not strip an already-inserted `<title>`), so the
        first-slide diagram keeps its `aria-labelledby` name. `.finally` (not
        `.then`) so the diagram still renders if reveal itself failed — the shared
        owner works standalone, and the server-rendered `<figure>`/`<pre>` remains
        the no-JS fallback (NFR-003) either way. */}
    <script>
      // Type-only import (erased at build — no runtime chunk). The runtime
      // modules are DYNAMICALLY imported below so `reveal-init.client` keeps its
      // own hashed chunk: it must stay route-isolated (ADR-0022 D5 — reveal's
      // viewport-hijacking core CSS never co-bundles onto a doc page) AND its
      // `?print-pdf` → `view:'print'` activation must ship in a chunk the build
      // assertion can find by name (BA-9 / FR-013). A static import co-bundles it
      // into DeckLayout's script chunk under a different filename, which breaks
      // both invariants.
      import type { DeckController } from '../lib/deck/reveal-init.client';

      // Resolve once reveal's root carries `.ready` (its initialise() promise
      // resolves a beat BEFORE the layout settles, and a diagram rendered into a
      // still-settling slide loses its accessible name — see the note above).
      // Bounded: fall through after a short wait so a page without reveal (or a
      // reveal that never readies) still proceeds to render.
      const whenRevealReady = () =>
        new Promise<void>((resolve) => {
          const root = document.querySelector('.reveal');
          if (!root || root.classList.contains('ready')) {
            resolve();
            return;
          }
          const done = () => {
            observer.disconnect();
            clearTimeout(fallback);
            // One extra frame so reveal's post-ready layout has flushed.
            requestAnimationFrame(() => resolve());
          };
          const observer = new MutationObserver(() => {
            if (root.classList.contains('ready')) done();
          });
          observer.observe(root, { attributes: true, attributeFilter: ['class'] });
          const fallback = setTimeout(done, 3000);
        });

      // PURE WIRE (A4): thread WP01's `DeckController` into the shared diagram
      // render owner, and nothing else — DeckLayout gains ZERO reveal knowledge
      // and holds NO slide state: it never subscribes to reveal events, reads
      // the active leaf, or computes print state (all of that lives in WP01's
      // reveal-init). The pinned shape (F5) resolves `controller` up front
      // so an `initDeck()` rejection cannot strand it in the temporal dead zone:
      // a caught failure simply leaves `controller` undefined, and
      // `initDiagrams(undefined)` renders the WHOLE document once (the intended
      // degraded whole-doc fallback when there is no controller — NOT a #15
      // regression; #15 only concerns the enhanced deck where the controller
      // exists and per-slide scoping applies). The `.reveal.ready` gate and its
      // requestAnimationFrame beat are preserved so diagrams still render only
      // AFTER reveal readies (INV-A11Y-ORDERING keeps the accTitle/accDescr
      // insertion off the race), and the SSR `<figure>`/`<pre>` stays the no-JS
      // fallback either way (INV-FALLBACK / NFR-003).
      // MODE-AWARE (#13 WP03). BUILD mode: the slides already carry static baked
      // `<svg>`s, so the client render owner is neither imported nor run — the
      // deck ships/pulls zero diagram runtime (NFR-001) and needs no settle. Only
      // reveal enhancement (slide navigation) loads. CLIENT fallback: preload the
      // render owner FIRST (its own chunk) so the degraded whole-doc render still
      // runs even if reveal enhancement fails, exactly as before. The mode is read
      // off `<body data-diagram-mode>` (server-stamped from `resolveDiagramMode`).
      const buildMode = document.body.dataset.diagramMode === 'build';
      const initDiagrams = buildMode
        ? null
        : (await import('../lib/diagram/diagram-render.client')).initDiagrams;
      let controller: DeckController | undefined;
      try {
        const { initDeck } = await import('../lib/deck/reveal-init.client');
        controller = await initDeck();
      } catch (err) {
        console.warn('[doc-kitty] deck enhancement failed:', err);
      }
      await whenRevealReady();
      // Client fallback only: a static build SVG needs no settle (INV-SETTLE stays
      // client-only). `initDiagrams` is `null` in build mode → no client render.
      if (initDiagrams) await initDiagrams(controller);

      // A11y (axe scrollable-region-focusable / WCAG 2.1.1): the deck theme gives
      // a slide's code `<pre>` `overflow:auto`, and reveal's fixed stage can make a
      // long block scroll — a scrollable region must be keyboard-reachable. Give
      // each such block a tabindex so keyboard users can scroll it. Scoped off the
      // rendered Mermaid `<pre>` (which becomes an `<svg>` figure, not a scroller).
      // SSR fallback stays clean (no reveal stage → the block does not overflow).
      document
        .querySelectorAll<HTMLElement>('.reveal .slides section pre:not(.mermaid)')
        .forEach((pre) => {
          if (!pre.hasAttribute('tabindex')) pre.tabIndex = 0;
        });
    </script>
  </body>
</html>
