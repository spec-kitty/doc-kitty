---
/*
 * Doc Kitty layout: Hub — described-link list (ADR-0013 single-layer substrate;
 * theming.md "Per-kind layouts", the one bespoke IN-FRAME layer shipped in M1).
 *
 * Renders in the NORMAL Starlight frame (sidebar, TOC, search, pagination stay
 * intact) — it is not a `splash`. The `MarkdownContent` carrier resolves
 * `kind: Hub` to this layout and forwards the Starlight route data as props
 * (same contract as Default.astro).
 *
 * Structure (theming.md "The per-kind layouts" → Hub):
 *   1. The page body's intro — the lead paragraph — rendered via `<slot />`
 *      (Starlight's MarkdownContent flows the markdown here).
 *   2. A named navigation landmark wrapping a list of described links to the
 *      section's CHILD pages. Each item is the related-card pattern: title in
 *      `--dk-color-text-accent`, the target page's own `description` in
 *      `--dk-color-text-muted`, plus an optional `kind` tag. Card-wide, ≥24px
 *      targets — styling in styles/hub.css.
 *
 * The card pattern is INLINED here for M1 (DIRECTIVE_024); M3 may extract a
 * shared primitive — do not build it now.
 *
 * Search coverage (NFR-004) vs. the navigation landmark — recorded deviation
 * (DIRECTIVE_010): theming.md specifies "a named `<nav>`", but Pagefind excludes
 * the `<nav>` TAG by default (it is designed to drop site chrome — Starlight's
 * own sidebar/header are `<nav>`s), which drops the child link text from the
 * index and REGRESSES NFR-004 (the WP's headline risk — verified empirically:
 * text inside `<nav>` is absent from the fragment, the same text in a non-`nav`
 * element is present). So the landmark is expressed as `role="navigation"` +
 * `aria-label` on a `<section>` — an IDENTICAL accessibility tree (a navigation
 * landmark with an accessible name) that Pagefind indexes because the tag is not
 * `nav`. Nothing carries `data-pagefind-ignore`; everything sits inside the
 * carrier, which Starlight places in `<main data-pagefind-body>`, so the lead
 * paragraph AND the child link text stay in Pagefind's indexed region.
 *
 * Child derivation: a child is a collection entry whose PARENT path equals this
 * Hub's slug — i.e. the pages one level down, in the same first path segment.
 * For the 2-level example tree this is exactly "same section" for every section
 * Hub (context → product, domain); it also lets the bundle-root Hub list the
 * section indexes instead of rendering an empty nav.
 */
import path from 'node:path';
import process from 'node:process';
import type { Props as StarlightRoute } from '@astrojs/starlight/props';
import { getCollection } from 'astro:content';
import {
  slugFromEntryId,
  sectionOf,
  sectionRank,
  isPublished,
  type DocKittyFrontmatter,
} from '../lib/metadata.js';
import { loadSectionRegistry, sectionOrder } from '../lib/sections.js';
// The ADR card's number+status+date and number-ordering come from the SHARED
// extractor pipeline in the ADR-index generator — NOT a Hub-local parse. This is
// the single source #50 mandates (D3/F5/F6): `buildAdrHubCards` is defined solely
// in terms of `extractAdrMeta`, the same extractor the own-tree table uses, so
// the two match 1:1 by construction. Re-deriving status/number here would recreate
// the split-brain this mission removes (guarded by hub-adr-card.test.ts, T023).
import { buildAdrHubCards } from '../scripts/generate-adr-index.mjs';
import '../styles/hub.css';

const route = Astro.props as StarlightRoute;
const currentSlug = slugFromEntryId(route.id);

// Honour the site `base` when building child hrefs.
const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, '');
const hrefFor = (slug: string): string =>
  slug === '' ? `${baseUrl}/` : `${baseUrl}/${slug}/`;

const parentOf = (slug: string): string => {
  const i = slug.lastIndexOf('/');
  return i === -1 ? '' : slug.slice(0, i);
};

// Section ordering follows the same registry the sidebar and discovery
// surfaces read, so the root Hub grid never diverges from them (DIRECTIVE_044:
// one source of truth). Falls back to the frozen SECTION_ORDER when no
// registry is present, exactly like the routes.
const registry = loadSectionRegistry(path.join(process.cwd(), 'docs'));
const order = registry ? sectionOrder(registry) : undefined;

// A rendered card. ADR cards additionally carry the lifecycle `status` badge and
// `date` derived by the shared extractor; non-ADR cards leave both undefined, so
// their markup is byte-identical to before (T020).
interface HubCard {
  slug: string;
  title: string;
  description?: string;
  kind?: string;
  /** ADR lifecycle status token (Proposed/Accepted/Superseded/Deprecated); '' ⇒ unbadged. */
  status?: string;
  /** ADR date (YYYY-MM-DD). */
  date?: string;
}

// INV-1 / US3: a Hub lists only PUBLISHED children — a draft child (e.g.
// adr/template) must never appear in the described-link list, mirroring the
// sitemap/agent-index draft exclusion (isPublished, the canonical predicate).
const publishedChildren = (await getCollection('docs')).filter((entry) => {
  const slug = slugFromEntryId(entry.id);
  return (
    slug !== currentSlug &&
    parentOf(slug) === currentSlug &&
    isPublished(entry.data as unknown as DocKittyFrontmatter)
  );
});

const isAdrKind = (data: DocKittyFrontmatter): boolean => data.kind === 'ADR';

// ADR children (C-005: gated to the ADR kind only): number+status+date and the
// number-ascending order come SOLELY from the shared pipeline — the SAME one the
// own-tree generator uses — so the hub matches the generated table 1:1 over the
// published+numbered set (NFR-004). `buildAdrHubCards` returns null-excluded
// (number-less + `type:Template`) exactly as `discoverAdrs`, so both sides list
// the same set (squad F5/F6). The `## Status` it reads lives in `entry.body`.
const adrCards: HubCard[] = buildAdrHubCards(
  publishedChildren
    .filter((entry) => isAdrKind(entry.data as unknown as DocKittyFrontmatter))
    .map((entry) => ({
      slug: slugFromEntryId(entry.id),
      data: entry.data,
      body: (entry as { body?: string }).body ?? '',
    })),
);

// Non-ADR children keep the existing section-rank → title sort. In a non-ADR hub
// (no ADR-kind children) this IS the whole list, byte-identical to before (T020).
const otherCards: HubCard[] = publishedChildren
  .filter((entry) => !isAdrKind(entry.data as unknown as DocKittyFrontmatter))
  .map((entry) => ({
    slug: slugFromEntryId(entry.id),
    data: entry.data as unknown as DocKittyFrontmatter,
  }))
  .sort((a, b) => {
    const bySection =
      sectionRank(sectionOf(a.slug), order) -
      sectionRank(sectionOf(b.slug), order);
    if (bySection !== 0) return bySection;
    return a.data.title.localeCompare(b.data.title);
  })
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    description: entry.data.description,
    kind: entry.data.kind,
  }));

const children: HubCard[] = [...adrCards, ...otherCards];

const navLabel =
  currentSlug === '' ? 'Documentation sections' : 'In this section';
---

<slot />

{
  children.length > 0 && (
    <section class="dk-hub" role="navigation" aria-label={navLabel}>
      <ul class="dk-hub__list" role="list">
        {children.map((child) => (
          <li class="dk-hub__item">
            <a class="dk-hub__card" href={hrefFor(child.slug)}>
              <span class="dk-hub__title">{child.title}</span>
              {/* Explicit spaces: adjacent inline spans render glued, which
                  would merge title/kind/status/description into one Pagefind token
                  and hurt search recall on the title word (NFR-004). */}
              {child.kind && (
                <>{' '}<span class="dk-hub__kind">{child.kind}</span></>
              )}
              {/* ADR-only: lifecycle status badge + date. The status token comes
                  from the shared extractor; empty/unparseable ⇒ unbadged (never
                  breaks the hub, T019). The word itself carries the meaning —
                  colour is only reinforcement (never colour-only), so it stays
                  legible in both themes. */}
              {child.status && (
                <>{' '}<span class="dk-hub__badge" data-adr-status={child.status.toLowerCase()}>{child.status}</span></>
              )}
              {child.date && (
                <>{' '}<span class="dk-hub__date">{child.date}</span></>
              )}
              {child.description && (
                <>{' '}<span class="dk-hub__desc">{child.description}</span></>
              )}
            </a>
            {/* A deck child also gets its `?print-pdf` export link, auto-derived
                from the collection — a sibling of the card-wide anchor, not a
                nested one (FR-014). Only decks (kind: Presentation) have one. */}
            {child.kind === 'Presentation' && (
              <a class="dk-hub__aux" href={`${hrefFor(child.slug)}?print-pdf`}>
                Print / PDF export
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
