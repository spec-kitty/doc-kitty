---
/*
 * DocKitty layout: Hub — described-link list (ADR-0013 single-layer substrate;
 * theming.md "Per-kind layouts", the one bespoke IN-FRAME layer shipped in M1).
 *
 * Renders in the NORMAL Starlight frame (sidebar, TOC, search, pagination stay
 * intact) — it is not a `splash`. The `MarkdownContent` carrier resolves
 * `kind: Hub` to this layout and forwards the Starlight route data as props
 * (same contract as Default.astro).
 *
 * Structure (theming.md "The per-kind layouts" → Hub):
 *   1. The page body's intro — the lead paragraph — rendered via `<slot />`
 *      (Starlight's MarkdownContent flows the markdown here).
 *   2. A named navigation landmark wrapping a list of described links to the
 *      section's CHILD pages. Each item is the related-card pattern: title in
 *      `--dk-color-text-accent`, the target page's own `description` in
 *      `--dk-color-text-muted`, plus an optional `kind` tag. Card-wide, ≥24px
 *      targets — styling in styles/hub.css.
 *
 * The card pattern is INLINED here for M1 (DIRECTIVE_024); M3 may extract a
 * shared primitive — do not build it now.
 *
 * Search coverage (NFR-004) vs. the navigation landmark — recorded deviation
 * (DIRECTIVE_010): theming.md specifies "a named `<nav>`", but Pagefind excludes
 * the `<nav>` TAG by default (it is designed to drop site chrome — Starlight's
 * own sidebar/header are `<nav>`s), which drops the child link text from the
 * index and REGRESSES NFR-004 (the WP's headline risk — verified empirically:
 * text inside `<nav>` is absent from the fragment, the same text in a non-`nav`
 * element is present). So the landmark is expressed as `role="navigation"` +
 * `aria-label` on a `<section>` — an IDENTICAL accessibility tree (a navigation
 * landmark with an accessible name) that Pagefind indexes because the tag is not
 * `nav`. Nothing carries `data-pagefind-ignore`; everything sits inside the
 * carrier, which Starlight places in `<main data-pagefind-body>`, so the lead
 * paragraph AND the child link text stay in Pagefind's indexed region.
 *
 * Child derivation: a child is a collection entry whose PARENT path equals this
 * Hub's slug — i.e. the pages one level down, in the same first path segment.
 * For the 2-level example tree this is exactly "same section" for every section
 * Hub (context → product, domain); it also lets the bundle-root Hub list the
 * section indexes instead of rendering an empty nav.
 */
import path from 'node:path';
import process from 'node:process';
import type { Props as StarlightRoute } from '@astrojs/starlight/props';
import { collectDocEntries } from '../lib/docs-index.js';
import {
  slugFromEntryId,
  type DocKittyFrontmatter,
} from '../lib/metadata.js';
import { hrefOfSlug } from '../lib/with-base.js';
import { selectHubChildren, composeHubChildren } from '../lib/hub-children.mjs';
import { loadAdrIdRule } from '../scripts/generate-adr-index.mjs';
import { resolveSectionRegistry, sectionOrder } from '../lib/sections.js';
import { routeShaping } from 'virtual:doc-kitty/route-shaping';
import HubCardList from '../components/hub/HubCardList.astro';
import HubPagination from '../components/hub/HubPagination.astro';
import { DEFAULT_HUB_PAGE_SIZE, hubPageCount, hubPageSlice, isPagedHub } from '../lib/child-cap.js';
import { listingCards, type HubCard } from '../lib/hub-pagination.js';
import '../styles/hub.css';

const route = Astro.props as StarlightRoute;
const currentSlug = slugFromEntryId(route.id);

// Child hrefs go through the shared route rule and honour the site `base`.
const hrefFor = hrefOfSlug;

// Section ordering follows the same registry the sidebar and discovery
// surfaces read, so the root Hub grid never diverges from them (DIRECTIVE_044:
// one source of truth). Falls back to the frozen SECTION_ORDER when no
// registry is present, exactly like the routes.
const docsRoot = path.join(process.cwd(), 'docs');
const registry = resolveSectionRegistry(docsRoot);
const order = registry ? sectionOrder(registry) : undefined;

// A rendered card (`HubCard`, shared with the paged listing in lib/hub-pagination.ts).
// ADR cards additionally carry the lifecycle `status` badge and `date` derived by the
// shared extractor; non-ADR cards leave both undefined, so their markup is
// byte-identical to before (T020).

// INV-1 / US3: a Hub lists only PUBLISHED children — a draft child (e.g.
// adr/template) must never appear in the described-link list, mirroring the
// sitemap/agent-index draft exclusion (isPublished, the canonical predicate).
// The parent-of-current filter + section-rank→title sort now live in the pure,
// importable `selectHubChildren` (#53), so the guard test exercises Hub's REAL
// selection instead of a replica; this is a behaviour-preserving extraction —
// the rendered output stays byte-identical (C-001).
const publishedChildren = selectHubChildren(
  await collectDocEntries({ withBody: true }),
  currentSlug,
  order,
);

// ADR children (C-005: gated to the ADR kind only): number+status+date and the
// number-ascending order come SOLELY from the shared pipeline — the SAME one the
// own-tree generator uses — so the hub matches the generated table 1:1 over the
// published+numbered set (NFR-004). The ADR-kind gate + `buildAdrHubCards` call
// is the single importable composition `selectAdrHubCards` (#57) — the same unit
// the guard test (hub-adr-card.test.ts) now exercises, so a regression in this
// wiring reds the test instead of a hand-kept replica. The id rule comes from
// the SAME docs root's charter (`adr.id`, #248) the generator reads, so a
// date-named tree gets the same ids and order on both sides.
// `composeHubChildren` is the one composition: the sidebar child cap (#341) counts
// and pages through the same list, so a capped hub's "N pages" and prev/next match.
const { adrCards: composedAdrCards, others } = composeHubChildren(publishedChildren, {
  idRule: loadAdrIdRule(docsRoot),
});
const adrCards: HubCard[] = composedAdrCards;

// Non-ADR children keep the section-rank → title order established by
// `selectHubChildren`. In a non-ADR hub (no ADR-kind children) this IS the whole
// list, byte-identical to before (T020).
const otherCards: HubCard[] = others
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    description: entry.data.description,
    kind: entry.data.kind,
  }));

const allCards: HubCard[] = [...adrCards, ...otherCards];

// The paged hub listing (#342): a hub over its sidebar child cap whose children
// outnumber its page size lists its first page here and the rest on
// `/<hub>/page/N/`. The slice comes from the build's hub data (one order and
// count, C-001); the cards are the ones composed above. Every other hub lists
// all its children exactly as before.
const hubEntry = routeShaping.hubCaps.find(([dir]) => dir === currentSlug)?.[1];
const paged = hubEntry !== undefined && isPagedHub(hubEntry);
const children: HubCard[] = paged
  ? listingCards(
      hubPageSlice(hubEntry.children.map((child) => child.slug), 1, hubEntry.pageSize ?? DEFAULT_HUB_PAGE_SIZE),
      new Map(allCards.map((card) => [card.slug, card])),
    )
  : allCards;
const pageCount = paged ? hubPageCount(hubEntry) : 1;
// The pagination sits on the list's own line below: an empty expression or a
// comment on a line of its own would add whitespace to every unpaged hub (NFR-005).

const navLabel =
  currentSlug === '' ? 'Documentation sections' : 'In this section';
---

<slot />

<HubCardList cards={children} navLabel={navLabel} hrefFor={hrefFor} />{paged && <HubPagination hub={currentSlug} current={1} total={pageCount} hrefFor={hrefFor} translate={Astro.locals.t} />}
