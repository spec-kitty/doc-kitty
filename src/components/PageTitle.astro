---
/*
 * DocKitty carrier: PageTitle (ADR-0013 substrate, theming.md slot surface).
 *
 * Hosts two of doc-kitty's own-chrome slots around Starlight's <h1>:
 *   - `dk:page-hero`    ABOVE the <h1> (WP03 renders entry.data.hero_image
 *                        through the Astro image pipeline).
 *   - `dk:metadata-band` BELOW the <h1> (WP03 renders the text-labelled
 *                        doc_status pill + updated + description).
 *
 * M1 ships the EMPTY host structure only — WP03 adds the slot bodies, so the
 * seams already exist and WP03 need not touch this carrier's shape. The band
 * host lives inside the normal content flow so its text stays in Starlight's
 * searchable region (NFR-004).
 *
 * Reads `Astro.locals.starlightRoute` (Starlight ≥0.30), never through
 * component props (the pre-0.30 pattern) — C-004.
 *
 * WP04 (FR-009/010/011): `kind: Persona` pages get NO identity render from this
 * carrier at all — no hero, no Starlight `<h1>`, no band. `Persona.astro`'s
 * passport card is the sole identity header for those pages (its own `<h1
 * id="_top">` takes over the skip-link / back-to-top target Starlight's title
 * normally provides). Each of the three top-level sections is gated with its
 * OWN `{!isPersona && …}` expression, kept separate rather than merged into one
 * wrapping `<Fragment>` — the inter-section blank lines are literal text nodes
 * at the template's top level, and folding multiple elements into a single JSX
 * expression together collapses that whitespace. On a non-Persona page every
 * element, class, attribute, and the `#_top` anchor render exactly as they did
 * before this carrier's `{!isPersona && …}` gating was introduced — the output
 * is structurally, visually, and semantically identical to main's — but the
 * gating itself collapses some INERT inter-block whitespace (squad-verified
 * against main's built HTML), so the two are NOT byte-identical. Keeping the
 * three sections separate holds that whitespace as close to unchanged as
 * possible without overclaiming a byte-for-byte guarantee (mirrors the
 * dormancy discipline in MarkdownContent.astro).
 *
 * gherkin-authoring-aids WP05 (FR-016, research R-07): a `doc_status: draft`
 * page renders `<DraftNotice />` once, after the band position. It sits OUTSIDE
 * the `dk:metadata-band` slot host, so a theme that overrides the band cannot
 * drop it, and OUTSIDE the Persona gates, so a Persona draft shows it too (the
 * passport card follows it). The test is the shared draft predicate,
 * `isDraftEntry`, so the site root (never a draft, always indexed) never shows
 * it. `doc_status` is missing only on Starlight's unparsed 404 fallback (the
 * schema defaults every collection entry), so that page is excluded too. The expression abuts the band section's
 * closing brace with no blank line between them: a separating line would be a
 * literal whitespace node that renders on EVERY page, so a non-draft page would
 * change by one space. Abutted, a non-draft page is byte-identical to before.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import type { Props as StarlightRoute } from '@astrojs/starlight/props';
import { slotComponents } from 'virtual:doc-kitty/manifest';
import { isDraftEntry, isPublished } from '../lib/metadata.js';
import PageHero from './slots/PageHero.astro';
import MetadataBand from './slots/MetadataBand.astro';
import DraftNotice from './slots/DraftNotice.astro';

const route = (Astro.locals as unknown as { starlightRoute: StarlightRoute })
  .starlightRoute;

// Per-carrier slot resolution (ADR-0015 decision 2): a theme may override the two
// M1 metadata slots through the merged manifest. With no theme `slotComponents`
// is empty → the M1 slot components (`PageHero`, `MetadataBand`) render
// unchanged, so the `data-dk-slot` hosts and band markers stay byte-identical.
const PageHeroSlot = slotComponents['dk:page-hero'];
const MetadataBandSlot = slotComponents['dk:metadata-band'];

// The convention's frontmatter reaches entry.data only via docsSchema({ extend })
// (WP01). Starlight's own Props type doesn't know those fields, so read the
// WP03-relevant slice through a narrow cast rather than widening to `any`.
const entry = route.entry;
const data = entry.data as unknown as {
  kind?: string;
  doc_status?: string;
  updated?: Date;
  description?: string;
  hero_image?: { src: string; alt: string };
};
// entry.filePath (relative to the site root) locates colocated hero assets.
const filePath = (entry as unknown as { filePath?: string }).filePath;
const showBand = isPublished(data as Parameters<typeof isPublished>[0]);
const isPersona = data.kind === 'Persona';
// Unlike the Head carrier (which may `noindex` the 404 fallback), the notice must not
// show there: the shared predicate treats a missing `doc_status` as `draft`, and it is
// missing only on Starlight's unparsed 404 fallback (the schema defaults every entry).
const isDraft = data.doc_status !== undefined && isDraftEntry(entry as unknown as Parameters<typeof isDraftEntry>[0]);
---

{
  !isPersona && (
    <>
      {/* dk:page-hero — theme override wins; else the M1 PageHero default. */}
      <div class="dk-page-hero" data-dk-slot="dk:page-hero">
        <slot name="dk:page-hero">
          {
            PageHeroSlot ? (
              <PageHeroSlot />
            ) : (
              <PageHero heroImage={data.hero_image} filePath={filePath} />
            )
          }
        </slot>
      </div>
    </>
  )
}

{!isPersona && <Default {...route} />}

{
  !isPersona && (
    <>
      {/* dk:metadata-band — theme override wins; else the M1 band on published pages. */}
      <div class="dk-metadata-band" data-dk-slot="dk:metadata-band">
        <slot name="dk:metadata-band">
          {
            MetadataBandSlot ? (
              <MetadataBandSlot />
            ) : (
              showBand && (
                <MetadataBand
                  docStatus={data.doc_status}
                  updated={data.updated}
                  description={data.description}
                />
              )
            )
          }
        </slot>
      </div>
    </>
  )
}{isDraft && <DraftNotice />}
