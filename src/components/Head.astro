---
/*
 * DocKitty carrier: Head (ADR-0013 substrate, theming.md slot surface).
 *
 * M1 is a thin pass-through: render Starlight's default <head>, then host
 * doc-kitty's own `dk:head` slot (WP03 fills it with the share/social meta —
 * og:image / twitter:image resolved by social_thumb → hero_image.src →
 * site-default, where the site-default is the theme's `assets.socialImage` when
 * set, else the toolkit-shipped default — FR-009). A stable `dk-chrome` marker
 * proves — in the built HTML — that the toolkit carrier loaded (not a silent
 * fallback to Starlight's own Head).
 *
 * Reads page state from `Astro.locals.starlightRoute` (Starlight ≥0.30
 * route-data API), never through component props (the pre-0.30 pattern) — C-004.
 * The cast types the locals field without widening to `any`.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import type { Props as StarlightRoute } from '@astrojs/starlight/props';
import { slotComponents, themeSocialImage } from 'virtual:doc-kitty/manifest';
import HeadShare from './slots/HeadShare.astro';
import { isDraftEntry } from '../lib/metadata.js';

const route = (Astro.locals as unknown as { starlightRoute: StarlightRoute })
  .starlightRoute;

// Per-carrier slot resolution (ADR-0015 decision 2): a theme may override
// `dk:head` through the merged manifest. With no theme `slotComponents` is empty
// → the doc-kitty default (HeadShare — the FR-009 og:image/twitter:image share
// path) renders. `themeSocialImage` (the theme's `assets.socialImage`, forwarded
// below) becomes HeadShare's terminal site-default; with no theme it is undefined,
// so the toolkit default ships (byte-identical to M1).
const DkHead = slotComponents['dk:head'];

// Convention frontmatter reaches entry.data via docsSchema({ extend }) (WP01);
// Starlight's Props type doesn't know these fields, so read the share-relevant
// slice through a narrow cast rather than widening to `any`.
const entry = route.entry;
const data = entry.data as unknown as {
  title?: string;
  hero_image?: { src: string; alt: string };
  social_thumb?: { src: string; alt: string } | string;
};
const filePath = (entry as unknown as { filePath?: string }).filePath;

// A draft that is being rendered must not be indexed (FR-015). With
// DK_PUBLISH_DRAFTS off the docs loader drops drafts, so this carrier only sees
// one when drafts are published. The test is the page's status alone, not the
// setting: a site whose docs do not go through `docKittyDocsLoader` still emits
// its drafts, and those must carry the marker too. The site root is exempt by
// the loader's own rule (`isDraftEntry`): a home page with no `doc_status` is
// never filtered, so it must never be `noindex` either.
const isDraft = isDraftEntry(entry as unknown as { id: string; data: { doc_status?: unknown } });
---

<Default {...route} />
{/* Proof-of-carrier marker (greppable in dist HTML), always emitted. */}
<meta name="dk-chrome" content="doc-kitty-carriers" />
{isDraft && <meta name="robots" content="noindex" />}
{/*
  dk:head slot: a theme override wins; otherwise the doc-kitty default — the
  og:image / twitter:image share metadata + fallback chain (unchanged from M1,
  proven by the three-distinct-og:image assertion).
*/}
{
  DkHead ? (
    <DkHead />
  ) : (
    <HeadShare
      heroImage={data.hero_image}
      socialThumb={data.social_thumb}
      filePath={filePath}
      title={data.title}
      siteDefault={themeSocialImage}
    />
  )
}
<slot name="dk:head" />
