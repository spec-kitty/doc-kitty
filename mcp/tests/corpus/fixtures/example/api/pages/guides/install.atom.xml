&lt;h2 id=&quot;5-build&quot;&gt;5. Build&lt;/h2&gt;
&lt;p&gt;Add a &lt;code dir=&quot;auto&quot;&gt;docs/README.md&lt;/code&gt; with frontmatter (&lt;code dir=&quot;auto&quot;&gt;title&lt;/code&gt;, &lt;code dir=&quot;auto&quot;&gt;description&lt;/code&gt;, &lt;code dir=&quot;auto&quot;&gt;doc_status&lt;/code&gt;,
&lt;code dir=&quot;auto&quot;&gt;updated&lt;/code&gt;, &lt;code dir=&quot;auto&quot;&gt;type&lt;/code&gt;, &lt;code dir=&quot;auto&quot;&gt;kind&lt;/code&gt;), then:&lt;/p&gt;
&lt;div class=&quot;expressive-code&quot;&gt;&lt;figure class=&quot;frame is-terminal not-content&quot;&gt;&lt;figcaption class=&quot;header&quot;&gt;&lt;span class=&quot;title&quot;&gt;&lt;/span&gt;&lt;span class=&quot;sr-only&quot;&gt;Terminal window&lt;/span&gt;&lt;/figcaption&gt;&lt;pre data-language=&quot;sh&quot;&gt;&lt;code&gt;&lt;div class=&quot;ec-line&quot;&gt;&lt;div class=&quot;code&quot;&gt;&lt;span style=&quot;--0:#82AAFF;--1:#3B61B0&quot;&gt;pnpm&lt;/span&gt;&lt;span style=&quot;--0:#D6DEEB;--1:#403F53&quot;&gt; &lt;/span&gt;&lt;span style=&quot;--0:#ECC48D;--1:#3B61B0&quot;&gt;astro&lt;/span&gt;&lt;span style=&quot;--0:#D6DEEB;--1:#403F53&quot;&gt; &lt;/span&gt;&lt;span style=&quot;--0:#ECC48D;--1:#3B61B0&quot;&gt;build&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/figure&gt;&lt;/div&gt;
&lt;p&gt;The build writes your pages plus &lt;code dir=&quot;auto&quot;&gt;sitemap.xml&lt;/code&gt;, &lt;code dir=&quot;auto&quot;&gt;rss.xml&lt;/code&gt;, &lt;code dir=&quot;auto&quot;&gt;llms.txt&lt;/code&gt; and the
&lt;code dir=&quot;auto&quot;&gt;/api/*.json&lt;/code&gt; agent API.&lt;/p&gt;
